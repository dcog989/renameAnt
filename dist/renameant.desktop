[Desktop Entry]
Type=Application
Name=renameAnt
GenericName=Bulk File Renamer
Comment=Rename many files and directories with an ordered rule pipeline
Exec=renameant-gui %F
Icon=renameant
MimeType=inode/directory;application/octet-stream;
Terminal=false
Categories=Utility;FileTools;
Keywords=rename;batch;bulk;files;directory;
StartupNotify=true
StartupWMClass=renameant
